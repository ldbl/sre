# Slack incoming webhooks for Alertmanager (flux/infrastructure/observability/alerting/slack-receivers.yaml).
# Copy to alertmanager-slack.yaml, put in the two URLs, encrypt in place:
#   sops --encrypt --in-place flux/secrets/observability/alertmanager-slack.yaml
# then list it in this folder's kustomization.yaml. Never commit it unencrypted.
apiVersion: v1
kind: Secret
metadata:
  name: alertmanager-slack
  namespace: observability
type: Opaque
stringData:
  production: "https://hooks.slack.com/services/replace-me-production"
  nonprod: "https://hooks.slack.com/services/replace-me-nonprod"
