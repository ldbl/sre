apiVersion: v1
kind: Secret
metadata:
  name: k8s-ai-monitor-secrets
  namespace: observability
type: Opaque
stringData:
  # LLM - the key of the provider LLM_PROVIDER names (openai on the platform)
  openai-api-key: "replace-me"
  anthropic-api-key: "replace-me"
  gemini-api-key: "replace-me"

  # Notification destination.
  # Can be Slack webhook OR OpsGenie bridge webhook.
  slack-webhook-url: "replace-me"
  slack-webhook-url-nonprod: "replace-me"

  # Required: guards every HTTP route but /healthz; Alertmanager sends it as a Bearer token.
  # Generate: openssl rand -hex 20
  internal-token: "replace-me"
